# Installers use Hugging Face's own login/cache. Never commit your token.
# HF_TOKEN=your-personal-read-token
# HF_HOME=/path/on/a/large/disk/huggingface
# TORCH_HOME=/path/on/a/large/disk/torch
# ANALYSIS_OUTPUT_DIR=/path/to/private-analysis-results
# Environment variables must be set in your shell; this is an example, not a
# credential file loaded automatically by Python.
